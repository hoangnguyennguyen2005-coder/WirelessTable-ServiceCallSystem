# Set these in the shell; app does not auto-load .env. Do not commit real tokens.
PBL_MODE=simulation
PBL_DATA_DIR=data
PBL_SERIAL_PORT=COM3
PBL_SERIAL_BAUD=115200
PBL_POLL_SECONDS=5
PBL_DOUBLE_MS=600
# Hardware staff prototype: generate your own token; never use placeholder.
PBL_STAFF_TOKEN=REPLACE_WITH_RANDOM_SECRET
PBL_STAFF_ID=1
