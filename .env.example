# Set these in the shell; the app does not auto-load .env. Do not commit real tokens.
PBL_MODE=simulation            # simulation | hardware (separate databases)
PBL_DATA_DIR=data
PBL_VENUE_ID=1                 # 1..65535; bound to the database and checked on every frame
PBL_SERIAL_PORT=COM3           # hardware mode only; /dev/ttyACM0 on Linux
PBL_SERIAL_BAUD=115200         # proposed; must match the gateway firmware

# Proposed logbook values (still open until user trials / bench tests)
PBL_POLL_SECONDS=5             # table-node poll while a request is open (energy-model assumption)
PBL_STAFF_POLL_SECONDS=2       # staff-device poll
PBL_DOUBLE_MS=1000             # recessed double-press window, provisional (ER-F09)
PBL_REMINDER_SECONDS=300       # overdue reminder (ER-F08)
PBL_UNRESOLVED_SECONDS=10      # unresolved-state visibility (ER-R03)
PBL_RETENTION_DAYS=90          # event record retention, minimum 30 (ER-F11)
PBL_LOW_BATTERY_MV=0           # 0 = off; the device's own battery_low flag is always honoured

# Hardware mode: diagnostic staff-device stub at /staff. Generate your own token.
PBL_STAFF_TOKEN=REPLACE_WITH_RANDOM_SECRET
PBL_STAFF_ID=1
